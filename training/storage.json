    {
      "root_ref": "artifact-publication-control",
      "location": "project://.synaptic/publication-control",
      "access": "read_create",
      "permit_ref": "permit-artifact-publication-control"
    },
    {
      "root_ref": "artifact-publication-spool",
      "location": "project://.synaptic/publication-spool",
      "access": "read_create",
      "permit_ref": "permit-artifact-publication-spool"
    },
    {
      "root_ref": "docker-model-inventory-source",
      "location": "project://.synaptic/model-inventory",
      "access": "read_only",
      "permit_ref": "permit-docker-model-inventory-source"
    }
  ]
