# Hidden-state extraction outputs (exploratory tier). These land under
# <model_tag>/hidden_states/ and are large reproducible tensor artifacts
# (per-arm safetensors + manifest + rows). The current model_tag dir
# (qwen3-4b-instruct/) is already fully ignored above; this anchored rule is a
# defensive guard so a FUTURE model_tag's hidden_states tree is never staged by
# `git add -A`, regardless of which model_tag dir is or isn't blanket-ignored.
*/hidden_states*/
