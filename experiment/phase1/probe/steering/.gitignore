# Persisted direction artifacts (reproducible from extraction dirs; do not commit)
direction_*.safetensors
direction_*.npy

# Test scratch / direction outputs
*/directions/
directions/

# EXCEPTION: the frozen qwen3.5-4b probe directions are pinned inputs of the
# signed Amendments AA/AB (gate L14 / dial L16, seed 20260630); cloud Arm B
# cells load them from a fresh clone, and the extraction dirs they are
# "reproducible from" are local-only. These four small files are the
# provenance artifacts of record.
!directions/
directions/*
!directions/qwen3.5-4b/
directions/qwen3.5-4b/*
!directions/qwen3.5-4b/direction_gate.json
!directions/qwen3.5-4b/direction_gate.safetensors
!directions/qwen3.5-4b/direction_dial.json
!directions/qwen3.5-4b/direction_dial.safetensors

# EXCEPTION: the deployed Qwen3-4B clean-SFT->GRPO-v2 caution_perp direction
# (unit-normalized, best_layer 34) shipped for the TODO item-11 GPU batching-
# parity self-check (modal_item11_equivalence.py). The Modal container loads it
# from a fresh clone at the pinned commit, so it must be tracked; the .npy holds
# the unit vector and is reproducible via build_equiv_direction.py.
!directions/qwen3-4b-grpo-v2/
directions/qwen3-4b-grpo-v2/*
!directions/qwen3-4b-grpo-v2/direction_caution.json
!directions/qwen3-4b-grpo-v2/direction_caution.npy

# pytest cache
.pytest_cache/
__pycache__/
*.pyc

# Any per-family output subtrees (mirroring the parent probe dir convention)
z_*/
*_result.json

# Per-cell run outputs (Amendment AA: steering/results/ is gitignored; the
# scored roll-up JSON is tracked at the probe root instead)
results/
