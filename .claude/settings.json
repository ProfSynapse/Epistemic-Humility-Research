{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block_memory_write.sh",
            "timeout": 10,
            "statusMessage": "Checking write target is not agent memory..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block_claudemd_write.sh",
            "timeout": 10,
            "statusMessage": "Checking write target is not a generated mirror (CLAUDE.md/skills)..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/launch_guard.sh",
            "timeout": 10,
            "statusMessage": "Checking launch is doc-recorded before running..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_note_tracker.sh prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_note_tracker.sh wrote",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
