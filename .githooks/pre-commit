#!/bin/sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if command -v py >/dev/null 2>&1; then
  PYTHON="py -3"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON="python3"
else
  PYTHON="python"
fi

$PYTHON bin/validate_kg.py

# Retired-terminology lint over staged papers/ and docs/ prose (SSOT:
# papers/common/terminology.md). Signed experiment text and archive/ are
# out of scope by design.
$PYTHON .githooks/check_retired_terms.py

if [ -d docs/sessions ]; then
  $PYTHON .agents/skills/experiment-runner/scripts/research_session.py validate docs/sessions
fi

# Experiments-first layout: validate every manifest and confirm the generated
# registry is current. Only runs when the experiments/ tree exists.
if [ -d experiments ]; then
  $PYTHON .agents/skills/experiments/scripts/exp.py validate
  $PYTHON .agents/skills/experiments/scripts/exp.py regen --check
fi

# Task-backlog layer: validate every task, confirm the TODO.md generated block
# is current, and gate any staged work file to an active covering task. Only
# runs when the backlog/ tree exists.
if [ -d backlog ]; then
  $PYTHON .agents/skills/task-backlog/scripts/task.py validate
  $PYTHON .agents/skills/task-backlog/scripts/build_todo_index.py --check
  $PYTHON .agents/skills/task-backlog/scripts/check_task_gate.py --staged
fi

# Typed-graph frontmatter/edge validation across the library.
# This vault carries many non-fatal KG331 ambiguity warnings; only surface output
# when it actually fails (non-zero exit = an ERROR), so commits stay quiet.
if ! kg_out="$($PYTHON .agents/skills/knowledge-graph/scripts/validate_kg_relationships.py library 2>&1)"; then
  printf '%s\n' "$kg_out"
  exit 1
fi
