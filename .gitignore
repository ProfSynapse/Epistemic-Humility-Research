# Re-fetchable binary archives: rebuild with library/scripts/fetch_library.py --enrich
library/pdfs/
library/fulltext/
# huggingface_hub snapshot_download bookkeeping
datasets/*/.cache/
.cache/

# working space (refetchable parquets etc.)
scratch/
.tmp/
.kg/

# local operational logs
archive/experiment/phase1/run_records/logs/

# Generated legacy probe artifacts. Keep reusable scripts/configs/notes in git,
# but do not publish raw logs, rows, vectors, or run-output directories by default.
archive/experiment/phase1/probe/analysis/**/_execution_logs/
archive/experiment/phase1/probe/analysis/**/_sweep_configs/
archive/experiment/phase1/probe/analysis/**/directions/
archive/experiment/phase1/probe/analysis/**/generation/
archive/experiment/phase1/probe/analysis/**/logit_diagnostic/
archive/experiment/phase1/probe/analysis/**/*.safetensors
archive/experiment/phase1/probe/analysis/**/*.jsonl
archive/experiment/phase1/probe/analysis/**/*.csv
archive/experiment/phase1/probe/analysis/**/*.json
archive/experiment/phase1/probe/analysis/**/metrics.json
archive/experiment/phase1/probe/analysis/**/run_manifest.json
archive/experiment/phase1/probe/analysis/**/sweep_manifest.json
archive/experiment/phase1/probe/analysis/**/planned_commands.jsonl
archive/experiment/phase1/probe/config/*.summary.json
archive/experiment/phase1/probe/config/*row_keys*.manifest.json
archive/experiment/phase1/probe/config/*_rows.jsonl
archive/experiment/phase1/probe/config/*_scored_rows.jsonl
archive/experiment/phase1/probe/manifests/

# Experiments-first tree (experiments/<slug>/). Per-experiment run outputs and
# fitted direction data are untracked, mirroring the legacy analysis convention;
# the manifest, amendment, configs, notebook, and shared common/ code stay tracked.
experiments/*/analysis/
experiments/*/directions/

# Root-level scratch analysis tree (2.2 GB of activations, extractions, and run
# outputs). Same convention as experiments/*/analysis/: private, regenerable, and
# it may contain question/eval-row text, which this PUBLIC repo never carries.
# Anything meant to be committed goes to analysis-committed/ instead.
/analysis/

# git worktrees (PACT feature isolation)
.worktrees/

# project-memory lock artifact
.claude/.CLAUDE.md.lock

# secrets
.env
.env.*

# Data too large for GitHub (regenerated deterministically by datasets/scripts/fetch_datasets.py)
datasets/triviaqa-rc-nocontext/train.jsonl

# Python bytecode / test caches
__pycache__/
*.pyc
.pytest_cache/
unsloth_compiled_cache/

.obsidian/

# web-app bundle dump (log-viewer artifact; not experiment data)
archive/experiment/phase1/probe/assets/
# Housekeeping 2026-07-05 (dirt audit): fetched mining datasets are re-downloadable;
# FalseQA additionally carries no upstream license (do not redistribute).
datasets/falseqa/
datasets/ambigqa/
datasets/bigbench-known-unknowns/
# marimo dashboard runtime cache + exported web bundle boilerplate (regenerable)
archive/experiment/phase1/probe/__marimo__/
archive/experiment/phase1/probe/sae_dashboard.html
archive/experiment/phase1/probe/.nojekyll
archive/experiment/phase1/probe/favicon*
archive/experiment/phase1/probe/logo.png
archive/experiment/phase1/probe/manifest.json
archive/experiment/phase1/probe/site.webmanifest
archive/experiment/phase1/probe/android-chrome-*.png
archive/experiment/phase1/probe/apple-touch-icon.png
# local-scope agent instructions for the probe dir
archive/experiment/phase1/probe/CLAUDE.md

# Shared Phase 1 infrastructure migrated out of the untracked experiment/
# tree (bin/migrate_phase1_outputs.py): per-checkpoint probe extraction,
# run records, data staging, configs, logs with no single owning amendment.
archive/experiment/phase1-data/
